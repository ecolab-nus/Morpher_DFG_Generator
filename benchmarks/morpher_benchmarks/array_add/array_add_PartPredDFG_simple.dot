digraph Region_18 {
	graph [ nslimit = "1000.0",
	orientation = landscape,
		center = true,
	page = "8.5,11",
	compound=true,
	size = "10,7.5" ] ;
"Op_5" [ fontname = "Helvetica" shape = box, label = " STORE"]
"Op_7" [ fontname = "Helvetica" shape = box, label = " LOAD"]
"Op_8" [ fontname = "Helvetica" shape = box, label = " ADD"]
"Op_10" [ fontname = "Helvetica" shape = box, label = " LOAD"]
"Op_7" -> "Op_8" [style = bold, color = black];
"Op_10" -> "Op_8" [style = bold, color = black];
"Op_8" -> "Op_5" [style = bold, color = black];
}
