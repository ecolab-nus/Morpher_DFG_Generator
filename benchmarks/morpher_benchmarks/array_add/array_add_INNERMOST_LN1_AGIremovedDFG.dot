digraph Region_18 {
	graph [ nslimit = "1000.0",
	orientation = landscape,
		center = true,
	page = "8.5,11",
	compound=true,
	size = "10,7.5" ] ;
"Op_5" [ fontname = "Helvetica" shape = box, label = " store  BB=for.body HyIns=STORE,
5, ASAP=2, ALAP=7"]
"Op_7" [ fontname = "Helvetica" shape = box, label = " load manupa1 BB=for.body HyIns=LOAD,
7, ASAP=0, ALAP=5"]
"Op_8" [ fontname = "Helvetica" shape = box, label = " add add BB=for.body HyIns=ADD,
8, ASAP=1, ALAP=6"]
"Op_10" [ fontname = "Helvetica" shape = box, label = " load manupa0 BB=for.body HyIns=LOAD,
10, ASAP=0, ALAP=5"]
"Op_7" -> "Op_8" [style = bold, color = black];
"Op_8" -> "Op_5" [style = bold, color = black];
"Op_10" -> "Op_8" [style = bold, color = black];
}
