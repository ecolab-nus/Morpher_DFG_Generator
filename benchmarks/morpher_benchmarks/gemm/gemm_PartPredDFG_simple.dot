digraph Region_18 {
	graph [ nslimit = "1000.0",
	orientation = landscape,
		center = true,
	page = "8.5,11",
	compound=true,
	size = "10,7.5" ] ;
"Op_17" [ fontname = "Helvetica" shape = box, label = " LOAD"]
"Op_18" [ fontname = "Helvetica" shape = box, label = " MUL"]
"Op_19" [ fontname = "Helvetica" shape = box, label = " ADD"]
"Op_20" [ fontname = "Helvetica" shape = box, label = " STORE"]
"Op_23" [ fontname = "Helvetica" shape = box, label = " LOAD"]
"Op_27" [ fontname = "Helvetica" shape = box, label = " LOAD"]
"Op_17" -> "Op_18" [style = bold, color = black];
"Op_23" -> "Op_18" [style = bold, color = black];
"Op_18" -> "Op_19" [style = bold, color = black];
"Op_27" -> "Op_19" [style = bold, color = black];
"Op_19" -> "Op_20" [style = bold, color = black];
}
